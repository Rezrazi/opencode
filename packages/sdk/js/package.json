{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rezrazi/opencode-sdk",
  "version": "1.3.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "bun ./script/build.ts",
    "publish": "bun ./script/publish.ts",
    "prepublishOnly": "bun x tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./v2": {
      "types": "./dist/v2/client.d.ts",
      "import": "./dist/v2/client.js"
    },
    "./v2/client": {
      "types": "./dist/v2/client.d.ts",
      "import": "./dist/v2/client.js"
    },
    "./v2/gen/client": {
      "types": "./dist/v2/gen/client/index.d.ts",
      "import": "./dist/v2/gen/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
